{
  "name": "crown-and-calculation",
  "private": true,
  "version": "0.1.0",
  "description": "Crown & Calculation: The Six-Square Federation — offline-first 6x6 chess (crown-la6-v1) with a local engine, Glicko-2 ratings and engine-based game analysis.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "node scripts/serve.mjs --dir dist",
    "serve": "node scripts/serve.mjs --dir dist --open",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node --experimental-strip-types --no-warnings tools/bench/run.ts",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.7",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
